<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dinex_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="14dp">
    <include layout="@layout/dinex_widget_header" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_available" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
    <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="38dp" android:text="@string/widget_sample_balance" android:textColor="#F2F5F3" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_status" android:textColor="#3DD68C" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"  />
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp">
        <ProgressBar android:id="@+id/widget_budget_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:minHeight="4dp" android:maxHeight="4dp" android:max="100" android:progress="40" android:indeterminate="false" android:progressDrawable="@drawable/dinex_widget_progress"  />
        <ProgressBar android:id="@+id/widget_budget_bar_over" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:minHeight="4dp" android:maxHeight="4dp" android:max="100" android:progress="40" android:indeterminate="false" android:progressDrawable="@drawable/dinex_widget_progress_over" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
