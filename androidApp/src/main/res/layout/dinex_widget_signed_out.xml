<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dinex_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="14dp"
    android:gravity="center">
    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_widget_mark" android:contentDescription="@null" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_signed_out_title" android:textColor="#F2F5F3" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_signed_out_body" android:textColor="#8FA39A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
</LinearLayout>
