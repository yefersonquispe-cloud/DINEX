<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginTop="11dp"
    android:orientation="horizontal">
    <LinearLayout android:id="@+id/widget_action_expense" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/dinex_widget_button_primary" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_minus" android:tint="#07130E" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/widget_expense" android:textColor="#07130E" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <LinearLayout android:id="@+id/widget_action_income" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/dinex_widget_button" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_plus" android:tint="#F2F5F3" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/widget_income" android:textColor="#F2F5F3" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="6dp" android:layout_height="1dp" />
    <LinearLayout android:id="@+id/widget_action_save" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/dinex_widget_button" android:gravity="center" android:orientation="horizontal">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_coin" android:tint="#F2F5F3" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/widget_save" android:textColor="#F2F5F3" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
