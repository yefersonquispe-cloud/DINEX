<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dinex_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_goals_title" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
            <TextView android:id="@+id/widget_savings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_balance" android:textColor="#F2F5F3" android:textSize="23sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginTop="1dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_action_save" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/dinex_widget_button_primary" android:gravity="center" android:orientation="horizontal" android:paddingStart="11dp" android:paddingEnd="13dp">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_plus" android:tint="#07130E" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="@string/widget_save" android:textColor="#07130E" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="11dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />
    <TextView android:id="@+id/widget_goals_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_goals_empty" android:textColor="#B9C7C0" android:textSize="12sp"  android:ellipsize="end" android:layout_marginTop="12dp" android:maxLines="2" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_goal_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_goal_name_0" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/widget_sample_goal" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:layout_weight="1" />
            <TextView android:id="@+id/widget_goal_saved_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" android:layout_marginStart="8dp" />
            <TextView android:id="@+id/widget_goal_percent_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40%" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" android:gravity="end" android:minWidth="34dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp">
            <ProgressBar android:id="@+id/widget_goal_bar_0" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:minHeight="4dp" android:maxHeight="4dp" android:max="100" android:progress="40" android:indeterminate="false" android:progressDrawable="@drawable/dinex_widget_progress"  />
        </FrameLayout>
    </LinearLayout><LinearLayout android:id="@+id/widget_goal_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_goal_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/widget_sample_goal" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:layout_weight="1" />
            <TextView android:id="@+id/widget_goal_saved_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" android:layout_marginStart="8dp" />
            <TextView android:id="@+id/widget_goal_percent_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40%" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" android:gravity="end" android:minWidth="34dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp">
            <ProgressBar android:id="@+id/widget_goal_bar_1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:minHeight="4dp" android:maxHeight="4dp" android:max="100" android:progress="40" android:indeterminate="false" android:progressDrawable="@drawable/dinex_widget_progress"  />
        </FrameLayout>
    </LinearLayout><LinearLayout android:id="@+id/widget_goal_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_goal_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/widget_sample_goal" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:layout_weight="1" />
            <TextView android:id="@+id/widget_goal_saved_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" android:layout_marginStart="8dp" />
            <TextView android:id="@+id/widget_goal_percent_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="40%" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" android:gravity="end" android:minWidth="34dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp">
            <ProgressBar android:id="@+id/widget_goal_bar_2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:minHeight="4dp" android:maxHeight="4dp" android:max="100" android:progress="40" android:indeterminate="false" android:progressDrawable="@drawable/dinex_widget_progress"  />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
