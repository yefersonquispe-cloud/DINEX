<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dinex_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="14dp">
    <include layout="@layout/dinex_widget_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_available" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
            <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="38dp" android:text="@string/widget_sample_balance" android:textColor="#F2F5F3" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:layout_marginEnd="12dp" android:background="#22FFFFFF" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="54dp" android:layout_height="wrap_content" android:text="@string/widget_income_label" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
                <TextView android:id="@+id/widget_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_income" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:gravity="end" android:minWidth="68dp" />
            </LinearLayout>
            <FrameLayout android:layout_width="1dp" android:layout_height="6dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="54dp" android:layout_height="wrap_content" android:text="@string/widget_expense_label" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
                <TextView android:id="@+id/widget_expense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:gravity="end" android:minWidth="68dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="10dp" />
    <include layout="@layout/dinex_widget_budget_row" />
    <include layout="@layout/dinex_widget_actions" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="10dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="10dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PULSO DEL DINERO" android:textColor="#3DD68C" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ingresos y gastos del periodo" android:textColor="#F2F5F3" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/dinex_widget_button" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entró" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_pill_income_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_income" android:textColor="#3DD68C" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:layout_width="5dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/dinex_widget_button" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salió" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_pill_expense_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#F28B82" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:layout_width="5dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/dinex_widget_button" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Balance" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_pill_balance_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_balance" android:textColor="#3DD68C" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" />
    <ImageView android:id="@+id/widget_cashflow_chart" android:layout_width="match_parent" android:layout_height="110dp" android:scaleType="fitCenter" android:contentDescription="Gráfico de ingresos y gastos del periodo" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/ic_widget_coin" android:tint="#3DD68C" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ingresos" android:textColor="#8FA39A" android:textSize="10sp" android:layout_marginStart="3dp" android:layout_marginEnd="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/ic_widget_coin" android:tint="#F28B82" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gastos" android:textColor="#8FA39A" android:textSize="10sp" android:layout_marginStart="3dp" android:layout_marginEnd="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/ic_widget_coin" android:tint="#818CF8" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saldo acum." android:textColor="#8FA39A" android:textSize="10sp" android:layout_marginStart="3dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_recent_heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_recent" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="12dp" android:layout_marginBottom="2dp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/widget_recent_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_recent_hidden" android:textColor="#8FA39A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_recent_0" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_recent_title_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_movement" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/widget_recent_detail_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_detail" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"  />
        </LinearLayout>
        <TextView android:id="@+id/widget_recent_amount_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" />
    </LinearLayout><LinearLayout android:id="@+id/widget_recent_1" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_recent_title_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_movement" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/widget_recent_detail_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_detail" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"  />
        </LinearLayout>
        <TextView android:id="@+id/widget_recent_amount_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" />
    </LinearLayout><LinearLayout android:id="@+id/widget_recent_2" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_recent_title_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_movement" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/widget_recent_detail_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_detail" android:textColor="#8FA39A" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"  />
        </LinearLayout>
        <TextView android:id="@+id/widget_recent_amount_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_sample_expense" android:textColor="#F2F5F3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:layout_marginStart="10dp" />
    </LinearLayout>
</LinearLayout>
