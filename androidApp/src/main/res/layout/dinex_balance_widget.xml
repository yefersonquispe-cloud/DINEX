<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:gravity="center_vertical"
    android:background="@drawable/dinex_widget_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DINEX  ·  TU DINERO"
        android:textColor="#D6F4DF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tu saldo disponible"
        android:textColor="#D6F4DF"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S/ 0.00"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/widget_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ahorrado S/ 0.00"
        android:textColor="#D6F4DF"
        android:textSize="12sp" />
</LinearLayout>
