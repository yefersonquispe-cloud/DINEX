rules_version = '2';

// Reglas de seguridad de Dinex.
// Cada persona solo puede leer y escribir su propio documento users/{uid}.
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'email', 'profile', 'updatedAt', 'termsVersion', 'termsAcceptedAt', 'aiDay', 'aiCount'])
          && data.keys().hasAll(['name', 'email', 'profile', 'updatedAt'])
          && data.name is string && data.name.size() <= 80
          && data.email is string && data.email == request.auth.token.email
          && data.profile is string && data.profile.size() < 1000000
          && data.updatedAt is int && data.updatedAt > 0
          // Constancia del consentimiento (Ley N.° 29733), opcional en cuentas antiguas.
          && (!('termsVersion' in data) || (data.termsVersion is string && data.termsVersion.size() <= 20))
          && (!('termsAcceptedAt' in data) || data.termsAcceptedAt is int)
          && validAiUsage(data);
      }

      // Consultas a Dinex IA del día (límite diario por usuario). Van juntas: día y cantidad.
      function validAiUsage(data) {
        return (!('aiDay' in data) && !('aiCount' in data))
          || (data.aiDay is int && data.aiCount is int
            && data.aiCount >= 0 && data.aiCount <= 100
            && data.aiDay <= request.time.toMillis() / 86400000 + 2);
      }

      // En el mismo día el conteo no puede bajar, ni volver a un día anterior.
      function aiUsageNotLowered() {
        let before = resource.data;
        let after = request.resource.data;
        return !('aiDay' in before) || !('aiDay' in after)
          || after.aiDay > before.aiDay
          || (after.aiDay == before.aiDay && after.aiCount >= before.aiCount);
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() && validProfile();
      allow update: if isOwner() && validProfile() && aiUsageNotLowered();
      allow delete: if isOwner();
    }

    // Reportes de respuestas de Dinex IA (política de contenido generado por IA de Google Play).
    // Cada persona solo puede crear reportes a su nombre. Para eliminar su cuenta puede buscar y
    // borrar únicamente sus propios reportes (uid igual al de su sesión); nunca los de otra persona.
    // Nadie puede cambiarlos. El equipo de Dinex los revisa desde la consola de Firebase.
    match /aiReports/{reportId} {
      function ownsReport() {
        return request.auth != null && resource.data.uid == request.auth.uid;
      }

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'reportId', 'reason', 'comment', 'answer', 'question', 'engine', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'reportId', 'reason', 'answer', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reportId == reportId
        && reportId.size() <= 80
        && request.resource.data.reason in ['ofensiva', 'peligrosa', 'incorrecta', 'otra']
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 4000
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
        && (!('question' in request.resource.data) || (request.resource.data.question is string && request.resource.data.question.size() <= 500))
        && (!('engine' in request.resource.data) || (request.resource.data.engine is string && request.resource.data.engine.size() <= 20))
        && request.resource.data.createdAt is int;
      // "list" solo funciona si la consulta filtra por uid == el de la sesión.
      allow get, list: if ownsReport();
      allow delete: if ownsReport();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
